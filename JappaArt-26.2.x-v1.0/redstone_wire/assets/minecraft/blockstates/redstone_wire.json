{
  "multipart": [
    {
      "apply": { "model": "minecraft:block/redstone_dust_cross" },
      "when": { "east": "side|up", "north": "side|up", "south": "side|up", "west": "side|up" }
    },
    {
      "apply": { "model": "minecraft:block/redstone_dust_dot" },
      "when": { "east": "none", "north": "none", "south": "none", "west": "none" }
    },
    {
      "apply": { "model": "minecraft:block/redstone_dust_line", "y": 90 },
      "when": { "north": "side|up", "east": "none", "south": "side|up", "west": "none"}
    },
    {
      "apply": { "model": "minecraft:block/redstone_dust_line"},
